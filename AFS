local validFruits = {
    ["Buddha"] = true, ["Chop"] = true, ["Flame"] = true, 
    ["Gear2"] = true, ["Goro"] = true, ["Ice"] = true, 
    ["Light"] = true, ["Magma"] = true, ["Mochi"] = true, 
