}

local function findCurrentFruit()
    local Workspace = game:GetService("Workspace")
    for _, child in ipairs(Workspace:GetChildren()) do
        if validFruits[child.Name] then
            return child
        end
    end
    return nil
end

local ToggleAutoPickUp = MainTab:CreateToggle({
   Name = "Auto Pick Up Fruit",
   CurrentValue = false,
   Flag = "FruitAutoPickUpToggle",
   Callback = function(Value)
        shared.FruitAutoPickUpActive = Value
        
        if shared.FruitAutoPickUpActive then
            task.spawn(function()
                local Players = game:GetService("Players")
                local localPlayer = Players.LocalPlayer
                
                while shared.FruitAutoPickUpActive do
                    local targetFruit = findCurrentFruit()
                    local character = localPlayer.Character
                    local rootPart = character and character:FindFirstChild("HumanoidRootPart")
                    
                    if targetFruit and rootPart then
                        rootPart.CFrame = targetFruit:GetPivot()
                        task.wait(0.1)
                        
                        local prompt = targetFruit:FindFirstChildOfClass("ProximityPrompt") or targetFruit:FindFirstChildWhichIsA("ProximityPrompt", true)
                        
                        if prompt then
                            if fireproximityprompt then
                                fireproximityprompt(prompt)
                            else
                                prompt:InputHoldBegin()
                                task.wait(prompt.HoldDuration or 0.1)
                                prompt:InputHoldEnd()
                            end
                        end
                    end
                    task.wait(0.4)
                end
            end)
        end
   end,
})
