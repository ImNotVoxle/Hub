local SellLemonsId = 79268393072444

local Scripts = {
    SellLemons = "https://raw.githubusercontent.com/ImNotVoxle/Hub/refs/heads/main/SellLemons",
    Universal = "https://raw.githubusercontent.com/ImNotVoxle/Hub/refs/heads/main/universal"
}

local function ExecuteUrl(url)
    local success, result = pcall(function()
        return game:HttpGet(url)
    end)

    if not success then
        warn("Failed to get script:", result)
        return
    end

    local loaded, loadErr = pcall(function()
        loadstring(result)()
    end)

    if not loaded then
        warn("Failed to execute script:", loadErr)
    end
end

print("Current PlaceId:", game.PlaceId)
print("Current GameId:", game.GameId)

if game.PlaceId == SellLemonsId or game.GameId == SellLemonsId then
    ExecuteUrl(Scripts.SellLemons)
else
    ExecuteUrl(Scripts.Universal)
end
