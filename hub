local SupportedGames = {
    [79268393072444] = "https://raw.githubusercontent.com/ImNotVoxle/Hub/refs/heads/main/SellLemons",
    [128784467030899] = "https://raw.githubusercontent.com/ImNotVoxle/Hub/refs/heads/main/MergeaNuke"
}

local UniversalScriptUrl = "https://githubusercontent.com"

local function ExecuteUrl(url)
    local success, result = pcall(function()
        return game:HttpGet(url)
    end)

    if not success then
        warn("Failed to download script from URL:", url, "\nError:", result)
        return
    end

    local loaded, loadErr = loadstring(result)
    if not loaded then
        warn("Failed to compile script structure:", loadErr)
        return
    end

    local executed, execErr = pcall(loaded)
    if not executed then
        warn("Runtime error during script execution:", execErr)
    end
end

print("[Hub] Current PlaceId:", game.PlaceId)
print("[Hub] Current GameId:", game.GameId)

local scriptToRun = SupportedGames[game.PlaceId] or SupportedGames[game.GameId]

if scriptToRun then
    print("[Hub] Supported game detected. Loading specific script...")
    ExecuteUrl(scriptToRun)
else
    print("[Hub] Game not supported. Loading universal script...")
    ExecuteUrl(UniversalScriptUrl)
end
