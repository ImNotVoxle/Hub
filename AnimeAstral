local function getNPC()
    local dist, thing = math.huge, nil
    local char = game.Players.LocalPlayer.Character
    if not (char and char:FindFirstChild("HumanoidRootPart")) then 
        return nil 
    end
    local myPos = char.HumanoidRootPart.Position
    
    for _, v in ipairs(game:GetService("Workspace").Worlds:GetDescendants()) do
        local matchesDropdown = (getgenv().mobname == nil or v.Name == getgenv().mobname)
        
        if v:IsA("Model") and v.Parent and v.Parent.Name == "Enemies" and matchesDropdown and v:GetAttribute("EnemyDead") == false then
            local hrp = v:FindFirstChild("HumanoidRootPart")
            if hrp then
                local mag = (myPos - hrp.Position).Magnitude
                if mag < dist then
                    dist = mag
                    thing = v
                end
            end
        end
    end
    return thing
end

local function getNPCTrial()
    local dist, thing = math.huge, nil
    local char = game.Players.LocalPlayer.Character
    if not (char and char:FindFirstChild("HumanoidRootPart")) then 
        return nil 
    end
    local myPos = char.HumanoidRootPart.Position

    pcall(function()
        local enemyFolder = game:GetService("Workspace").TimeTrialArenas.Easy.Enemies
        for _, v in ipairs(enemyFolder:GetChildren()) do
            if v:IsA("Model") and v:GetAttribute("EnemyDead") ~= true then
                local hrp = v:FindFirstChild("HumanoidRootPart")
                if hrp then
                    local mag = (myPos - hrp.Position).Magnitude
                    if mag < dist then 
                        dist = mag 
                        thing = v 
                    end
                end
            end
        end
    end)
    return thing
end

