local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer
local player = game.Players.LocalPlayer

local function GetMyTycoon()
    for _, tycoon in ipairs(workspace:GetChildren()) do
        local ownerValue = tycoon:FindFirstChild("Owner")
        if ownerValue and ownerValue.Value == LocalPlayer then
            return tycoon
        end
    end
    return nil
end

local LocationsList = {}
local myTycoonBase = GetMyTycoon()
local targetTycoon = myTycoonBase or workspace:FindFirstChild("Tycoon6") or workspace:FindFirstChild("Tycoon8")

if targetTycoon and targetTycoon:FindFirstChild("Locations") then
    for _, v in ipairs(targetTycoon.Locations:GetChildren()) do
        if v:IsA("Part") then
            if not table.find(LocationsList, v.Name) then
                table.insert(LocationsList, v.Name)
            end
        end
    end
end

local visitedTrees = {}

local function getLEMON()
    local dist = math.huge 
    local thing = nil
    if not player.Character or not player.Character:FindFirstChild("HumanoidRootPart") then return nil end
    local myPos = player.Character.HumanoidRootPart.Position

    for _, v in ipairs(workspace:GetDescendants()) do
        if v:IsA("Model") and v.Name == "LemonTree" and not visitedTrees[v] then
            local fruit = v:FindFirstChild("Fruit")
            local clickPart = fruit and fruit:FindFirstChild("ClickPart")
            if clickPart then
                local detector = clickPart:FindFirstChildOfClass("ClickDetector")
                if detector then 
                    local mag = (myPos - clickPart.Position).Magnitude
                    if mag < dist then 
                        dist = mag 
                        thing = v 
                    end
                end
            end
        end
    end
    
    if not thing then
        table.clear(visitedTrees)
    end
    
    return thing
end

Y.Toggle({
    Text = "Auto Pick Lemons",
    Callback = function(Value)
        _G.AutoPick = Value
        if not Value then return end
        
        task.spawn(function()
            while _G.AutoPick do
                pcall(function()
                    local closestTree = getLEMON()
                    if closestTree and player.Character then
                        local hrp = player.Character:FindFirstChild("HumanoidRootPart")
                        local fruit = closestTree:FindFirstChild("Fruit")
                        local clickPart = fruit and fruit:FindFirstChild("ClickPart")
                        
                        if hrp and clickPart then
                            local detector = clickPart:FindFirstChildOfClass("ClickDetector")
                            hrp.CFrame = clickPart.CFrame * CFrame.new(0, 2, 0)
                            if detector then
                                visitedTrees[closestTree] = true
                                task.spawn(function()
                                    fireclickdetector(detector)
                                end)
                            end
                        end
                    end
                end)
                task.wait(0.15) 
            end
        end)
    end,
    Enabled = false
})

Y.Toggle({
    Text = "Auto Click (All Locations)",
    Callback = function(Value)
        _G.AutoClick = Value
        task.spawn(function()
            local myTycoon = GetMyTycoon()
            while _G.AutoClick do 
                task.wait(1)
                
                if not myTycoon then
                    myTycoon = GetMyTycoon()
                end
                
                if myTycoon and #LocationsList > 0 then
                    for _, rawLocation in ipairs(LocationsList) do
                        if not _G.AutoClick then break end
                        
                        local formattedLocation = string.gsub(rawLocation, "%s+", "")
                        
                        pcall(function()
                            myTycoon:WaitForChild("Remotes"):WaitForChild("WakeIncomeStream"):InvokeServer(formattedLocation)
                        end)
                    end
                end
            end
        end)
    end,
    Enabled = false
})

